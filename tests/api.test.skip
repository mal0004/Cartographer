const test = require('node:test');
const assert = require('node:assert/strict');
const { spawn } = require('node:child_process');
const PORT = 3107; const BASE = `http://127.0.0.1:${PORT}`; let serverProc;
function waitForServer(){return new Promise((resolve,reject)=>{const t=setTimeout(()=>reject(new Error('Server startup timeout')),10000);serverProc.stdout.on('data',(b)=>{if(String(b).includes('Cartographer running')){clearTimeout(t);resolve();}});});}
async function api(method,path,body){const res=await fetch(`${BASE}${path}`,{method,headers:{'Content-Type':'application/json'},body:body?JSON.stringify(body):undefined});const data=await res.json().catch(()=>({}));return{res,data};}
test.before(async()=>{serverProc=spawn(process.execPath,['server.js'],{env:{...process.env,PORT:String(PORT)},stdio:['ignore','pipe','pipe']});await waitForServer();});
test.after(()=>{if(serverProc)serverProc.kill('SIGTERM');});
test('world + entity + event CRUD with validation', async()=>{const invalidWorld=await api('POST','/api/worlds',{name:''});assert.ok(invalidWorld.res.status>=400);const createdWorld=await api('POST','/api/worlds',{name:'Test Realm',time_start:10,time_end:20});assert.equal(createdWorld.res.status,201);const worldId=createdWorld.data.id;const invalidEntity=await api('POST',`/api/worlds/${worldId}/entities`,{type:'badtype',name:'X',data:{}});assert.ok(invalidEntity.res.status>=400);const river=await api('POST',`/api/worlds/${worldId}/entities`,{type:'river',name:'River A',data:{sourceX:10,sourceY:20,path:[{x:1,y:2}]}});assert.equal(river.res.status,201);const invalidEvent=await api('POST',`/api/worlds/${worldId}/events`,{title:'',date:'x'});assert.ok(invalidEvent.res.status>=400);const event=await api('POST',`/api/worlds/${worldId}/events`,{title:'Founding',date:123,category:'political',entity_ids:[river.data.id]});assert.equal(event.res.status,201);const exported=await api('GET',`/api/worlds/${worldId}/export`);assert.equal(exported.res.status,200);});
